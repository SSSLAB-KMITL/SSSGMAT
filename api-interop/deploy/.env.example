# คัดลอกเป็น .env แล้วแก้ค่า (.env ไม่ถูก commit: มี hash ของรหัสผ่าน และ token)

# --- ชื่อโดเมน: ต้องมี DNS A/AAAA ชี้มาที่เครื่องนี้ และเปิด port 80, 443 (TCP) + 443 (UDP) ก่อน Caddy จึงขอใบรับรองได้
GNSS_STUDIO_DOMAIN=gnss.example.com
GPREDICT_WEB_DOMAIN=gpredict.example.com
EO_STUDIO_DOMAIN=eo.example.com
# อีเมลที่ Let's Encrypt ใช้แจ้งเรื่องใบรับรอง
ACME_EMAIL=admin@example.com

# --- login (basic auth) ใช้ร่วมทั้งสามแอป
# สร้าง hash: docker run --rm caddy:2.11.9 caddy hash-password --plaintext 'รหัสผ่านยาว ๆ'
# ใส่ในเครื่องหมาย ' ' เสมอ (hash มี $ ซึ่ง compose จะตีเป็นตัวแปรถ้าไม่ครอบ)
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH='$2a$14$แทนที่ด้วยผลของ_caddy_hash-password'

# --- (ไม่บังคับ) Cesium ion token ของ GNSS Studio (Globe Manager → Cesium ion) เว้นว่าง = ไม่ใช้
CESIUM_ION_TOKEN=

# --- (ไม่บังคับ) image ที่ใช้ ตั้งต้นคือ tag :prod ที่ build.sh สร้าง ใส่ tag ที่เป็นเลข commit เพื่อ rollback ได้
# GNSS_STUDIO_IMAGE=gnss-studio:prod
# GPREDICT_WEB_IMAGE=gpredict-web:prod
# EO_STUDIO_IMAGE=eo-studio:prod
# CADDY_IMAGE=caddy:2.11.9

# --- (ไม่บังคับ) หน่วยความจำสูงสุดของ Earth Observation Studio (worker SAR/YOLO)
# EO_STUDIO_MEM_LIMIT=8g

# --- (ไม่บังคับ) port ของ Caddy บนเครื่อง ใช้ค่าอื่นเฉพาะตอนทดสอบ (Let's Encrypt ต้องใช้ 80/443)
# HTTP_PORT=80
# HTTPS_PORT=443
