%----------------------------------------------------------------------
% GPS visibility from THBK, generated by gnss_predict
%----------------------------------------------------------------------

Create Spacecraft G16;
G16.DateFormat    = UTCGregorian;
G16.Epoch         = '10 Nov 2026 00:00:00.000';
G16.Id            = '27663';
G16.EphemerisName = '/fixtures/gps_2sat.tle';

Create Spacecraft G22;
G22.DateFormat    = UTCGregorian;
G22.Epoch         = '10 Nov 2026 00:00:00.000';
G22.Id            = '26407';
G22.EphemerisName = '/fixtures/gps_2sat.tle';

Create GroundStation THBK;
THBK.CentralBody      = Earth;
THBK.StateType        = Spherical;
THBK.HorizonReference = Ellipsoid;
THBK.Location1        = 13.729779;
THBK.Location2        = 100.781151;
THBK.Location3        = 0.0064;

Create CoordinateSystem THBKTopo;
THBKTopo.Origin = THBK;
THBKTopo.Axes   = Topocentric;

Create Propagator TLEProp;
TLEProp.Type            = SPICESGP4;
TLEProp.InitialStepSize = 30;

Create ReportFile RF;
RF.Filename     = '/work/report.txt';
RF.Precision    = 16;
RF.WriteHeaders = true;
RF.FixedWidth   = false;
RF.Delimiter    = ',';
RF.Add          = { ...
    G16.UTCGregorian, ...
    G16.THBKTopo.X, ...
    G16.THBKTopo.Y, ...
    G16.THBKTopo.Z, ...
    G22.THBKTopo.X, ...
    G22.THBKTopo.Y, ...
    G22.THBKTopo.Z};

BeginMissionSequence;
Propagate TLEProp(G16, G22) {G16.ElapsedSecs = 3600};
