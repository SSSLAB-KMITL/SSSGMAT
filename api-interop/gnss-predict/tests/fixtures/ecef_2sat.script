% EarthFixed positions of GNSS satellites from TLE (SGP4), generated by gnss_predict
Create Spacecraft G01;
G01.DateFormat = UTCGregorian;
G01.Epoch = '10 Nov 2026 00:00:00.000';
G01.Id = 'G01';
G01.EphemerisName = '/x/all.tle';
Create Spacecraft C01;
C01.DateFormat = UTCGregorian;
C01.Epoch = '10 Nov 2026 00:00:00.000';
C01.Id = 'C01';
C01.EphemerisName = '/x/all.tle';
Create Propagator TLEProp;
TLEProp.Type = SPICESGP4;
TLEProp.InitialStepSize = 30;
Create ReportFile RF;
RF.Filename = '/x/r.txt';
RF.Precision = 16;
RF.WriteHeaders = true;
RF.FixedWidth = false;
RF.Delimiter = ',';
RF.Add = {G01.UTCGregorian, G01.EarthFixed.X, G01.EarthFixed.Y, G01.EarthFixed.Z, C01.EarthFixed.X, C01.EarthFixed.Y, C01.EarthFixed.Z};
BeginMissionSequence;
Propagate TLEProp(G01, C01) {G01.ElapsedSecs = 86400};
